# Copy to deploy/.env and fill in. docker compose reads it automatically.
# cloud-init.yaml generates this file with fresh random secrets on first boot;
# this template is for manual/local setup.

# Public domain Caddy will request a cert for. Point its DNS at the VM first.
DOMAIN=murderbot.gg

# Where the bot/manager reach Redroid's adbd. Keep in sync across the stack.
ADB_TARGET=redroid:5555

# Postgres (db name must stay 'murderbot' unless you also change app defaults).
POSTGRES_DB=murderbot
POSTGRES_USER=murderbot
POSTGRES_PASSWORD=CHANGE-ME-strong-random

# Manager session signing secret (any long random string).
#   openssl rand -base64 48 | tr -d '\n'
NEO_SECRET=CHANGE-ME-random-48-bytes

# Fernet key that encrypts stored Evony credentials at rest. MUST be a urlsafe
# base64 of 32 bytes. Generate with:
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
EVONY_ENC_KEY=CHANGE-ME-fernet-key
